      "artifacts": [
       {
        "id": "dem-ky-tu",
        "title": "Đếm ký tự mạng xã hội",
        "height": 330,
        "description": "Đếm ký tự, từ, hashtag và so với giới hạn TikTok, Instagram, Facebook QC, X, YouTube.",
        "html": "<!doctype html>\n<html lang=\"vi\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n*{box-sizing:border-box}html,body{margin:0}\nbody{padding:10px;background:#12151b;color:#e6e8ee;font:13px/1.45 \"Be Vietnam Pro\",system-ui,sans-serif}\ntextarea{width:100%;min-height:90px;background:#0e1016;color:#e6e8ee;border:1px solid #2a2f3a;border-radius:8px;padding:8px;font:inherit;resize:vertical}\ntextarea:focus{outline:none;border-color:#7c5cff}\n.k{display:flex;gap:12px;margin:8px 0;color:#8b93a5}.k b{color:#e6e8ee}\n.p{margin:6px 0}.p .top{display:flex;justify-content:space-between;gap:8px}\n.bar{height:6px;background:#1f232c;border-radius:6px;overflow:hidden;margin-top:3px}.bar i{display:block;height:100%;background:#7c5cff}\n.p.over .bar i{background:#ff6b6b}.p.over .top span:last-child{color:#ff6b6b}\n.muted{color:#8b93a5;font-size:12px}\n</style></head><body>\n<textarea id=\"t\" placeholder=\"Dán nội dung bài đăng / caption…\"></textarea>\n<div class=\"k\"><span><b id=\"c\">0</b> ký tự</span><span><b id=\"w\">0</b> từ</span><span><b id=\"h\">0</b> hashtag</span></div>\n<div id=\"list\"></div>\n<div class=\"muted\">Giới hạn có thể thay đổi theo nền tảng — kiểm tra lại khi đăng.</div>\n<script>\nconst $=id=>document.getElementById(id);\nconst P=[['TikTok — caption',4000],['Instagram — caption',2200],['Facebook QC — hiện trước “Xem thêm”',125],['X (Twitter)',280],['YouTube — tiêu đề',100],['YouTube — mô tả',5000]];\nconst len=t=>[...t].length;\nfunction calc(){const t=$('t').value,c=len(t);\n  $('c').textContent=c;$('w').textContent=(t.match(/[\\p{L}\\p{N}]+/gu)||[]).length;$('h').textContent=(t.match(/#[\\p{L}\\p{N}_]+/gu)||[]).length;\n  $('list').innerHTML=P.map(([n,l])=>`<div class=\"p ${c>l?'over':''}\"><div class=\"top\"><span>${n}</span><span>${c}/${l}</span></div><div class=\"bar\"><i style=\"width:${Math.min(100,c/l*100)}%\"></i></div></div>`).join('');\n  return c}\nfunction summary(){const c=calc();const over=P.filter(([,l])=>c>l).map(([n,l])=>`${n} (vượt ${c-l})`);\n  return`${c} ký tự, ${$('w').textContent} từ, ${$('h').textContent} hashtag.`+(over.length?`\\nVượt giới hạn: ${over.join('; ')}`:'\\nVừa với mọi nền tảng trong danh sách.')}\n$('t').oninput=calc;\nMicron.onInput(d=>{if(d.text&&d.text.trim())$('t').value=d.text;Micron.send('text',summary())});\ncalc();\n</script>\n</body></html>\n"
       }
